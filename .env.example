# ──────────────────────────────────────────────
#  Voyara — Environment Variables
# ──────────────────────────────────────────────
#  Copy this file to .env and fill in the values.
#  cp .env.example .env
# ──────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ── Vega AI Service ───────────────────────────
# URL of the Vega AI backend (FastAPI)
VITE_VEGA_AI_URL=https://your-vega-ai-url.onrender.com

# ── Server ────────────────────────────────────
# Port for the Express server (Render sets this automatically)
PORT=10000
